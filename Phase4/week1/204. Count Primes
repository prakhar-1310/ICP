class Solution {
    public int countPrimes(int n) {
        if (n<=2) {  // 0 and 1 are not prime
			return 0;
		}
		int ans[] = new int[n];
		ans[0]=ans[1]=1;  // marking index 0 and 1 as not prime

		for (int i=2;i*i<=ans.length;i++) {
			if (ans[i]==0) { // i prime h
				for (int j=2;i*j<ans.length;j++) {
					ans[i*j]=1;
				}		
			}
		}
		int count=0;
		for (int i : ans) {
			if (i==0) {
				count++;
			}
		}
		return count;
    }
}
