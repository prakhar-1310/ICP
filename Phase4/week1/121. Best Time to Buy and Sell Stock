import java.util.*;
class Solution {
    public int maxProfit(int[] prices) {
        int max_profit = 0;
        int buyprice = Integer.MAX_VALUE;
        for (int i =0; i<prices.length;i++){
            if (prices[i]>buyprice){
                int profit = prices[i]-buyprice;
                max_profit = Math.max(profit,max_profit);
            }
            else{
                buyprice=prices[i];
            }
        }
        return max_profit;
    }
}
